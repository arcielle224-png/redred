@charset "utf-8";

#workskin .translate-toggle { cursor: pointer; border-bottom: 1px dotted rgb(196, 196, 196); }

#workskin .translate-toggle .translate-alt { display: none; }

#workskin .translate-toggle .translate-default { display: inline; }

#workskin .translate-toggle:hover .translate-default { display: none; }

#workskin .translate-toggle:hover .translate-alt { display: inline; font-style: italic; }

#workskin .player { max-width: 480px; margin: 1em auto; padding: 16px; background: rgb(24, 24, 24); border-radius: 12px; color: rgb(255, 255, 255); overflow: hidden; }

#workskin .player img { float: left; width: 96px; height: 96px; margin: 0px 16px 0px 0px; border-radius: 8px; }

#workskin .player .info { overflow: hidden; }

#workskin .player .title { margin: 0px; font-weight: bold; font-size: 1.1em; color: rgb(255, 255, 255); }

#workskin .player .artist { margin: 0px 0px 10px; font-size: 0.9em; color: rgb(179, 179, 179); }

#workskin .player audio { width: 100%; height: 36px; }

#workskin .wikipedia { width: 80%; max-height: 450px; margin: 0px auto 30px; background:  0% 0% / 100% 25px rgb(255, 255, 255); display: block; box-shadow: rgba(0, 0, 0, 0.12) 0px 1px 3px, rgba(0, 0, 0, 0.24) 0px 1px 2px; border-style: solid; border-width: 2px; border-color: rgb(51, 51, 51); border-radius: 5px; padding: 10px 25px; box-sizing: border-box; overflow: hidden auto; }

#workskin .wikipedia .articletitle { width: 100%; float: left; padding: 0px; font-size: 26px; font-family: "Linux Libertine", Georgia, Times, serif; color: rgb(0, 0, 0); }

#workskin .wikipedia .articlebody { width: 100%; float: left; font-size: 16px; text-align: justify; font-family: Arial, sans-serif; color: rgb(0, 0, 0); }

#workskin .wikipedia .articlelink { color: rgb(38, 66, 139); text-decoration: underline; }

#workskin .wikipedia .left { width: 65%; float: left; padding: 0px; font-size: 22px; font-family: "Linux Libertine", Georgia, Times, serif; color: rgb(0, 0, 0); }

#workskin .leftsection { padding: 0px; margin-bottom: 0px; font-weight: bold; color: rgb(0, 0, 0); font-size: 22px; font-family: "Linux Libertine", Georgia, Times, serif; border-bottom: 1px solid rgb(212, 212, 212); }

#workskin .wikipedia .leftbody { width: 100%; float: left; font-size: 16px; text-align: justify; font-family: Arial, sans-serif; color: rgb(0, 0, 0); }

#workskin .wikipedia .leftsub { width: 100%; float: left; font-weight: bold; font-size: 18px; text-align: justify; font-family: Arial, sans-serif; color: rgb(0, 0, 0); margin: 0px; padding: 0px; }

#workskin .wikipedia .right { width: 30%; float: right; padding: 0px; font-family: Arial, sans-serif; color: rgb(0, 0, 0); background:  0% 0% / 100% 25px rgb(230, 230, 230); display: table; box-shadow: rgba(0, 0, 0, 0.12) 0px 1px 3px, rgba(0, 0, 0, 0.24) 0px 1px 2px; border-style: solid; border-width: 1px; border-color: rgb(212, 212, 212); border-radius: 2px; }

#workskin .wikipedia .rightsub { width: 100%; margin: 0px auto; text-align: center; display: table; }

#workskin .rightdivider { width: 100%; text-align: center; display: table; padding: 10px 0px 0px; margin-bottom: 0px; font-family: Arial, sans-serif; color: rgb(0, 0, 0); border-bottom: 1px solid rgb(212, 212, 212); }

#workskin .rightdivider2 { width: 100%; text-align: center; display: table; padding: 0px; margin-bottom: 0px; font-family: Arial, sans-serif; color: rgb(0, 0, 0); border-bottom: 1px solid rgb(212, 212, 212); }

#workskin .wikipedia .rightcolumnleft { width: 45%; float: left; margin: 0px 0px 0px 5%; text-align: justify; font-weight: bold; }

#workskin .wikipedia .rightcolumnright { width: 45%; float: right; margin: 0px 5% 0px 0px; text-align: justify; }

#workskin .wikihr { color: rgb(212, 212, 212); width: 100%; text-align: left; float: left; }

#workskin .post-it { display: block; background: rgb(255, 208, 138); text-decoration: none; font-family: "Comic Sans MS", "Chalkboard SE", sans-serif; height: 10em; width: 10em; padding: 1em; text-align: left; margin-left: 46%; margin-right: auto; margin-top: -7%; box-shadow: rgba(0, 0, 0, 0.2) 0px -40px 40px inset, rgba(0, 0, 0, 0.2) 0px 25px 10px inset, rgba(0, 0, 0, 0.2) 0px 5px 6px 5px; transform: rotate(2deg); overflow: hidden; color: rgb(36, 36, 36); }

#workskin .post-it2 { display: block; background: rgb(138, 153, 255); text-decoration: none; font-family: "Comic Sans MS", "Chalkboard SE", sans-serif; height: 10em; width: 10em; padding: 1em; text-align: left; margin-left: 25%; margin-right: auto; box-shadow: rgba(0, 0, 0, 0.2) 0px -40px 40px inset, rgba(0, 0, 0, 0.2) 0px 25px 10px inset, rgba(0, 0, 0, 0.2) 0px 5px 6px 5px; transform: rotate(-6deg); border-radius: 0px 0px 0px 40px; overflow: hidden; color: rgb(36, 36, 36); }

#workskin .post-it3 { display: block; background: rgb(255, 138, 169); text-decoration: none; font-family: "Comic Sans MS", "Chalkboard SE", sans-serif; height: 10em; width: 10em; padding: 1em; text-align: left; margin-left: 40%; margin-right: auto; margin-top: -5%; box-shadow: rgba(0, 0, 0, 0.2) 0px -40px 40px inset, rgba(0, 0, 0, 0.2) 0px 25px 10px inset, rgba(0, 0, 0, 0.2) 0px 5px 6px 5px; transform: rotate(4deg); color: rgb(36, 36, 36); }

#workskin .article1 { display: block; max-width: 100%; height: auto; margin: 30px auto; border-radius: 0px; box-shadow: rgba(0, 0, 0, 0.5) 0px 4px 8px; }

#workskin .mobilevideo { position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; }

#workskin .videoscale { position: relative; height: 0px; padding-top: 56.25%; }

#workskin .videocontainer { max-width: 100%; width: 560px; margin: 0px auto; }

#workskin .letter { position: relative; margin: 0px auto 90px; font-size: 100%; font-family: "Gill Sans", sans-serif; width: 600px; height: 240px; max-width: 80%; min-width: 50%; transition: 2s 2s; }

#workskin .letter:hover { height: 600px; transition: 2s; }

#workskin .letter_cover { position: absolute; top: -20px; left: -20px; color: rgb(39, 42, 48); background: radial-gradient(rgb(211, 211, 190) 0%, rgb(224, 217, 187) 50%, rgb(197, 177, 150) 100%); box-shadow: rgba(0, 0, 0, 0.063) -2px 1px 5px 1px, rgba(0, 0, 0, 0.063) 1px -2px 5px 1px; border: 1px solid rgba(56, 60, 69, 0.314); width: 110%; min-height: 240px; max-height: 240px; transition: 2s 2s; z-index: 8; }

#workskin .letter_cover:hover { cursor: wait; }

#workskin .letter:hover .letter_cover { top: -100px; left: 0px; background: radial-gradient(rgb(211, 211, 190) 0%, rgb(224, 217, 187) 50%, rgb(197, 177, 150) 100%); transform: rotate(15deg); transition: 2s; z-index: 0; }

#workskin .letter_cover_text { position: relative; margin: 0px auto; top: 60px; max-width: 70%; min-width: 50%; font-size: 1.1em; overflow: visible; }

#workskin .letter_cover_text_top { position: absolute; top: 10px; left: 20px; max-width: 60%; min-width: 30%; font-size: 0.7em; overflow: visible; }

#workskin .letter_top { position: absolute; top: 0px; left: 0px; color: rgb(56, 60, 69); background: radial-gradient(rgb(236, 236, 212) 0%, rgb(224, 216, 185) 71%, rgb(236, 230, 183) 100%); height: 200px; max-width: 100%; border: 1px solid rgba(56, 60, 69, 0.314); border-top-right-radius: 4px; border-top-left-radius: 4px; box-shadow: rgba(0, 0, 0, 0.063) -5px 5px 10px 1px; transition: 2s 2s; z-index: 7; }

#workskin .letter_top_text { position: relative; margin: 0px auto; top: 20px; height: 170px; max-width: 90%; font-size: 0.8em; overflow: auto; }

#workskin .letter:hover .letter_top { left: -20px; transform: skew(5deg); transition: 2s; }

#workskin .letter_mid { position: absolute; top: 0px; left: 0px; color: rgb(56, 60, 69); background: radial-gradient(rgb(236, 236, 212) 0%, rgb(224, 216, 185) 71%, rgb(236, 230, 183) 100%); height: 200px; max-width: 100%; box-shadow: rgba(0, 0, 0, 0.063) -5px -3px 10px 1px; border-left: 1px solid rgba(56, 60, 69, 0.314); border-right: 1px solid rgba(56, 60, 69, 0.314); transition: 2s 2s; z-index: 6; }

#workskin .letter_mid_text { position: relative; margin: 0px auto; top: -5px; max-width: 90%; height: 220px; font-size: 0.8em; overflow: auto; }

#workskin .letter:hover .letter_mid { top: 200px; left: -20px; transform: skew(-5deg); transition: 2s; }

#workskin .letter_bottom { position: absolute; top: 0px; left: 0.1px; color: rgb(56, 60, 69); background: radial-gradient(rgb(236, 236, 212) 0%, rgb(224, 216, 185) 71%, rgb(236, 230, 183) 100%); height: 200px; max-width: 100%; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; border-left: 1px solid rgba(56, 60, 69, 0.314); border-right: 1px solid rgba(56, 60, 69, 0.314); border-bottom: 1px solid rgba(56, 60, 69, 0.314); box-shadow: rgba(0, 0, 0, 0.063) -5px -3px 10px 1px; overflow: visible; box-sizing: border-box; transition: 2s 2s; z-index: 5; }

#workskin .letter_bottom_text { position: relative; top: -35px; margin: 0px auto; max-width: 90%; height: 190px; font-size: 0.8em; overflow: auto; }

#workskin .letter:hover .letter_bottom { top: 400px; left: -20px; transition: 2s; transform: skew(5deg); }

#workskin .letter_top_text::-webkit-scrollbar, #workskin .letter_mid_text::-webkit-scrollbar, #workskin .letter_bottom_text::-webkit-scrollbar { appearance: none; display: block; }

