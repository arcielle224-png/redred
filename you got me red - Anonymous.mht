#dashboard .current::after { content: "Â âœ¿"; }

.home .header h2::after { content: "Â âœ¿"; }

.splash > .module h3::after { content: "Â âœ¿"; }

a.tag:not(.fandom.index.group a.tag, h2.heading a.tag, .splash .favorite a.tag, h5.fandoms.heading a.tag, dd.fandom.tags a, [class^="warning"] a.tag, [class^="relationship"] a, [class^="character"] a.tag)::after { content: "Â Â âœ¿"; }

