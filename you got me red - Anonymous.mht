#symbols-key dl { border: 1px solid rgb(221, 221, 221); margin-bottom: 1.286em; padding: 0.15em; }

#symbols-key dl dt img, #bookmark-symbols-key dt img, #symbols-key dl dt, #bookmark-symbols-key dt { height: 25px; width: 25px; }

#symbols-key dl dd, #bookmark-symbols-key dd { margin: -25px auto 20px 35px; }
