.filters [type="radio"]:checked + .indicator::before { background: radial-gradient(rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.8) 11%, rgba(0, 0, 0, 0) 23%), linear-gradient(rgb(187, 187, 187) 0%, rgb(221, 221, 221) 5%, rgb(255, 255, 255) 100%) rgb(255, 255, 255); }

.filters .exclude [type="checkbox"] + .indicator::before { content: " âœ•"; }

.filters .exclude [type="checkbox"]:checked + .indicator::before { background: linear-gradient(rgb(255, 255, 255) 2%, rgb(239, 209, 209) 95%, rgb(216, 190, 190) 100%) rgb(254, 222, 222); color: rgb(255, 0, 0); }

ul.tree, ul.tree li { display: block; }

.tag_wranglers-index #tag_wranglers { width: 75%; float: left; }

dl.nomination { border: 0px; margin: 0px; padding: 0px; box-shadow: none; }

.nomination dt, .nomination dd { float: none; display: inline-block; margin: 0px; padding: 0px; width: auto; }

.nomination dt { background: rgb(255, 255, 255); width: 50%; }

.nomination dd.autocomplete ul, .nomination dd.autocomplete li { margin-bottom: -0.375em; }

dd.autocomplete li.input { margin: 0px; padding: 0px; }

.userstuff { overflow-wrap: break-word; line-height: 1.5; }

.userstuff p, .userstuff details { margin: 1.286em auto; padding: 0px; }

.userstuff dl { margin: 1.5em 0px; border: 0px; }

.userstuff dl dl { width: 90%; margin: auto; }

.userstuff dt { display: block; font-weight: bold; }

.userstuff dd { display: block; margin-block: 1.25em; margin-inline-start: 3em; }

.userstuff dd p { margin: 0px; padding: 0px; }

.userstuff ul { margin: 1.125em auto; padding: 0px 1em; }

.userstuff ul li { display: list-item; }

.userstuff li, .userstuff ol ul li { font-weight: normal; display: list-item; list-style-type: disc; margin-block: 0.75em; margin-inline: 1.75em 0px; }

.userstuff ol { margin: 0.75em auto; padding: 0px 1.5em; }

.userstuff ol li { list-style-type: decimal; margin-block: 0.75em; margin-inline: 1.75em 0px; }

.userstuff ol li ol li { list-style-type: lower-alpha; }

.userstuff ol li ol li ol li { list-style-type: lower-roman; }

.userstuff h1 { text-align: center; }

.userstuff h2 { color: rgb(51, 51, 51); margin: 1.5em 0px; display: block; }

.userstuff h3 { font-weight: 500; padding: 0.125em; border-bottom: 0.25em double rgb(51, 51, 51); }

.userstuff h4 { font-weight: 700; }

.userstuff h5 { font-weight: 600; font-size: 1em; }

.userstuff h6 { font-size: 0.975em; border-bottom: 1px solid; }

.userstuff h3 a, .userstuff h3 a:link, .userstuff h3 a:visited { font-weight: 500; border-bottom: 0px; text-decoration: none; }

.userstuff caption { font-size: 1em; height: auto; width: auto; opacity: 1; }

.userstuff table, .userstuff td, .userstuff col, .userstuff tr, .userstuff thead, .userstuff tfoot, .userstuff tbody, .userstuff th, .userstuff thead td, .userstuff th a, .userstuff th a:link { background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.userstuff blockquote, .userstuff address { line-height: 1.5; margin-inline-start: 1.5em; padding: 0.75em; border-inline-start: 2px solid rgb(153, 153, 153); }

.userstuff blockquote blockquote { padding: 0.25em; border: 0px; }

.userstuff hr { width: 33%; margin: 0.875em auto 1.2525em; border: 1px solid; }

.userstuff img { max-width: 100%; height: auto; }

.userstuff video { max-width: 100%; }

#workskin { font-size: 1.08em; margin: auto; padding: 0px 0.25em; max-width: 72em; overflow: auto hidden; position: relative; }

#workskin .module { float: none; }

.comment .userstuff li { list-style-position: inside; }

.comment .userstuff blockquote { display: flow-root; }

.bookmark .user .userstuff { line-height: 1.5; }

.bookmark .user .userstuff blockquote { margin-bottom: 1.286em; }

.faq .userstuff dd { margin-block: 0.75em; margin-inline-start: 1.75em; }

.faq .userstuff dl { margin: 0.75em 0px; }

.important { font-weight: 900; }

.required, .error, .alert.flash { color: rgb(153, 0, 0); }

.footnote { font-size: 0.75em; float: right; }

.datetime { font-family: monospace; }

div.error { margin: 0.643em auto; padding: 0.25em 0.375em; border-radius: 0.25em; }

.notice, .comment_notice, .kudos_notice, ul.notes, .caution, .error, .comment_error, .kudos_error, .alert.flash { background: rgb(209, 225, 239); border: 1px solid rgb(194, 210, 223); margin: 0.643em auto; padding: 0.25em 0.375em; clear: right; box-shadow: 1px 1px 2px inset; border-radius: 0.25em; overflow-wrap: break-word; }

.caution { background: rgb(255, 227, 78); color: rgb(0, 0, 0); border-color: rgb(216, 158, 54); }

.error, .comment_error, .kudos_error, .alert.flash { background: rgb(239, 209, 209); border-color: rgb(153, 0, 0); box-shadow: 1px 1px 2px; }

p.notes, p.note { clear: right; }

form .notice, form ul.notes { box-shadow: rgb(255, 255, 255) 0px 0px 3px; }

.notice p { margin: 0px; padding: 0.643em; }

ul.notes, .error ul, .notice ul, .caution ul, .alert.flash ul { position: static; margin: auto 0.643em; padding: 0.25em 2.5em; }

ul.notes li, .error ul li, .notice ul li, .caution ul li, .alert.flash ul li { list-style-type: disc; padding-left: 1.5em; }

p span.error, dt span.error, dd span.error { display: block; }

dd.complex span.error { display: inline-block; }

.annotation { background: rgb(238, 238, 238); border: 1px solid rgb(204, 204, 204); float: none; line-height: 1; margin: 0.643em auto; padding: 1.286em; width: fit-content; display: flex; flex-flow: wrap; align-items: center; justify-content: center; gap: 1.286em; }

.annotation .image { width: auto; float: none; line-height: 1; }

.annotation .notes { text-align: center; }

.annotation .notes code { font-size: 1.286em; }

.annotation .notes .footnote { float: none; }

.annotation .actions { float: none; margin-block-end: 0px; padding-block-end: 0px; }

.actions + .footnote { clear: both; }

.announcement { clear: both; position: relative; }

.announcement .userstuff { background: rgb(209, 225, 239); border: 1px solid rgb(194, 210, 223); color: rgb(51, 51, 51); margin: 0px 2em; padding: 0.375em 0.75em; text-align: left; }

.announcement .userstuff p { margin: 0.375em auto; }

.announcement p.submit { bottom: -1em; margin: 0px; padding: 0px; position: absolute; right: 1em; z-index: 1; }

.announcement .action { background: none rgb(255, 255, 255); border: 1px solid rgb(187, 187, 187); padding: 0.25em 0.5em; border-radius: 2em; }

.announcement h1, .announcement h2, .announcement h3, .announcement h4, .announcement h5, .announcement h6, .banner h1, .banner h2, .banner h3, .banner h4, .banner h5, .banner h6 { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: inherit; margin: 0px; text-align: center; text-shadow: none; }

.event .userstuff { background: linear-gradient(rgb(119, 0, 0) 0%, rgb(170, 0, 0) 100%) rgb(119, 0, 0); border-color: rgb(102, 0, 0); color: rgb(255, 255, 255); }

.event .userstuff a { color: rgb(238, 238, 238); }

.alert .userstuff { background: rgb(254, 206, 63); border-color: rgb(237, 178, 2); color: rgb(51, 51, 51); }

.announcement .thermometer-content { height: 2.6em; margin: auto; width: 50%; }

.announcement .thermometer { position: relative; }

.announcement .thermometer .track { background: linear-gradient(rgb(255, 255, 255) 0%, rgb(243, 243, 243) 50%, rgb(237, 237, 237) 51%, rgb(255, 255, 255) 100%) rgb(255, 255, 255); border: 1px solid rgb(170, 170, 170); height: 1.25em; margin: 0px auto; position: relative; }

.announcement .thermometer .progress { bottom: 0px; left: 0px; height: 100%; position: absolute; }

.announcement .thermometer .goal { position: absolute; right: 0px; }

.announcement .thermometer .amount { font-weight: 700; line-height: 1.25em; position: absolute; }

.announcement .thermometer .goal .amount { left: 0px; padding-left: 0.25em; top: 0px; }

.announcement .thermometer .progress .amount { top: 1.35em; right: 0px; }

span.symbol { color: rgb(42, 84, 124); font-family: Georgia, serif; border: 1px solid; vertical-align: super; border-radius: 0.75em; }

span.symbol span { padding: 0.425em; }

.symbols a, .symbol a { text-decoration: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.question a:hover { background: rgb(42, 84, 124); border-color: rgb(209, 225, 239); color: rgb(255, 255, 255); cursor: help; }

span.question { background: rgb(209, 225, 239); border-color: rgb(42, 84, 124); box-shadow: rgba(0, 0, 0, 0.25) -1px -1px 2px; }

a.question { border: 0px; font-weight: bold; }

.heading a.question { font-size: 0.75em; }

dl#symbols-key dt { width: 100px; }

