.edit_external_author ul ul { margin-left: 2.75em; }

a.resp-sharing-button__link, .resp-sharing-button__icon { display: inline-block; }

a.resp-sharing-button__link, a.resp-sharing-button__link:hover { text-decoration: none; color: rgb(255, 255, 255); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.resp-sharing-button { border-radius: 5px; transition: 25ms ease-out; padding: 0.5em 0.75em; }

.resp-sharing-button__icon svg { width: 1.25em; height: 1.25em; margin-right: 0.25em; vertical-align: text-bottom; overflow: visible; }

.resp-sharing-button__icon { stroke: rgb(255, 255, 255); fill: none; }

.resp-sharing-button__icon--solid { fill: rgb(255, 255, 255); stroke: none; }

